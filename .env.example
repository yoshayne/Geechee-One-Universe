# Postgres connection string (Railway provides this)
DATABASE_URL=postgres://user:password@localhost:5432/geechee
# Redis connection string (used only for rate limiting; site works without it)
REDIS_URL=redis://localhost:6379
# Railway bucket (S3-compatible) for image uploads
BUCKET_ENDPOINT=
BUCKET_NAME=
BUCKET_ACCESS_KEY_ID=
BUCKET_SECRET_ACCESS_KEY=
BUCKET_REGION=auto
# Optional: set to true only if your bucket needs path-style addresses (Railway does not)
BUCKET_FORCE_PATH_STYLE=false
# Long random text that signs the admin login session
JWT_SECRET=change-me-to-a-long-random-string
# The single admin account, created on first start if none exists
ADMIN_EMAIL=you@example.com
ADMIN_PASSWORD=choose-a-strong-password
# TMDB key for importing film data
TMDB_API_KEY=
# Public address of the site, used in share-preview tags
PUBLIC_SITE_URL=http://localhost:3000
